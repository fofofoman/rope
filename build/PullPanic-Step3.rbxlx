      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--!strict
-- 2026-11-19 Rojo에서 생성한 RemoteEvent 참조를 공용 모듈에서 제공

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Types = require(script.Parent.Types)

local remoteFolder = ReplicatedStorage:WaitForChild("Remotes")
assert(remoteFolder:IsA("Folder"), "ReplicatedStorage.Remotes는 Folder여야 합니다.")

local function waitForRemote(name: string): RemoteEvent
	local remote = remoteFolder:WaitForChild(name)
	assert(remote:IsA("RemoteEvent"), name .. "은 RemoteEvent여야 합니다.")
	return remote
end

local remotes: Types.RemoteEvents = {
	MashBatch = waitForRemote("MashBatch"),
	QteIssued = waitForRemote("QteIssued"),
	QteResponse = waitForRemote("QteResponse"),
	PuzzleIssued = waitForRemote("PuzzleIssued"),
	PuzzleSubmit = waitForRemote("PuzzleSubmit"),
	PuzzleResult = waitForRemote("PuzzleResult"),
	MatchState = waitForRemote("MatchState"),
	-- 2026-11-20 재시작 요청 Remote 참조 추가
	MatchRestart = waitForRemote("MatchRestart"),
}

return remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
-- 2026-11-19 서버와 클라이언트가 공유하는 RemoteEvent 참조 타입 정의

export type RemoteEvents = {
	MashBatch: RemoteEvent,
	QteIssued: RemoteEvent,
	QteResponse: RemoteEvent,
	PuzzleIssued: RemoteEvent,
	PuzzleSubmit: RemoteEvent,
	PuzzleResult: RemoteEvent,
	MatchState: RemoteEvent,
	-- 2026-11-20 경기 종료 후 재시작 요청 Remote 추가
	MatchRestart: RemoteEvent,
}

-- 2026-11-19 경기 상태와 참가자 타입 추가
export type MatchPhase = "Waiting" | "Countdown" | "Playing" | "Ended"
export type MatchWinner = "A" | "B" | "Draw"
export type MatchStateExtra = { winner: MatchWinner }

-- 2026-11-19 퍼즐 정의, 클라이언트 렌더러 및 발행 상태 타입 추가
export type PuzzleReward = "Buff" | "InstantPull"
export type PuzzleDef = {
	kind: string,
	reward: PuzzleReward,
	generate: (rng: Random, difficulty: number) -> (any, any),
	validate: (displayData: any, solutionInfo: any, submission: unknown) -> boolean,
}

export type PuzzleRenderer = {
	render: (parent: GuiObject, displayData: any, onSubmit: (submission: unknown) -> ()) -> (),
	cleanup: () -> (),
}

export type ActivePuzzle = {
	id: number,
	definition: PuzzleDef,
	displayData: any,
	solutionInfo: any,
	issuedAt: number,
	expiresAt: number,
}

export type ParticipantState = {
	rawTps: number,
	buffUntil: number,
	stunUntil: number,
	activePuzzle: ActivePuzzle?,
}

return {}
]]></string>
        </Properties>
      </Item>
